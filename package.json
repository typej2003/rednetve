{
    "private": true,
    "scripts": {
        "dev": "export NODE_OPTIONS=--openssl-legacy-provider && npm run development",
        "development": "export NODE_OPTIONS=--openssl-legacy-provider && mix",
        "watch": "export NODE_OPTIONS=--openssl-legacy-provider && mix watch",
        "watch-poll": "export NODE_OPTIONS=--openssl-legacy-provider && mix watch -- --watch-options-poll=1000",
        "hot": "export NODE_OPTIONS=--openssl-legacy-provider && mix watch --hot",
        "prod": "export NODE_OPTIONS=--openssl-legacy-provider && npm run production",
        "production": "export NODE_OPTIONS=--openssl-legacy-provider && mix --production"
    },
    "devDependencies": {
        "@popperjs/core": "^2.10.2",
        "axios": "^0.21",
        "bootstrap": "^5.1.3",
        "laravel-mix": "^6.0.6",
        "laravel-mix-purgecss": "^6.0.0",
        "lodash": "^4.17.19",
        "postcss": "^8.1.14",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.32.11",
        "sass-loader": "^11.0.1"
    },
    "dependencies": {
        "bootstrap-icons": "^1.13.1"
    }
